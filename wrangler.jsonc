{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barns",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "barns"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Check-in notifications to Kim. Sends only from an address on kingslandbarn.co.uk,
  // which must be onboarded to Cloudflare Email Sending, and only to the bookings inbox.
  "send_email": [
    {
      "name": "CHECKIN_EMAIL",
      "destination_address": "booking@kingslandbarn.co.uk"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "GUEST_LOGS",
      "id": "a3cb521e96a74e00996299e00ffee745"
    }
  ]
}
