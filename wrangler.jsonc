{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barns",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "barns"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Check-in notifications to Kim. kingslandbarn.co.uk uses Cloudflare Email Routing (booking@
  // forwards to daviskingsland@outlook.com), and a Worker can send to a verified Email Routing
  // destination without onboarding the domain to Email Sending. So send straight to that inbox.
  "send_email": [
    {
      "name": "CHECKIN_EMAIL",
      "destination_address": "daviskingsland@outlook.com"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "GUEST_LOGS",
      "id": "a3cb521e96a74e00996299e00ffee745"
    }
  ]
}
